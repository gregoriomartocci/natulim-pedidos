# Tienda: el dominio .myshopify.com de la dev store
SHOPIFY_SHOP=natulim-sevica.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Credenciales de la app (Dev Dashboard → la app → Settings).
# El client secret también firma los webhooks (HMAC).
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Opcional: si la tienda tiene una custom app "legacy" creada desde el admin,
# su token (shpat_...) va acá y no se usa client credentials.
SHOPIFY_ADMIN_TOKEN=

# Base de datos del requerimiento 3
DB_PATH=pedidos.sqlite3

# Cada requerimiento se prende por separado (para ponerlos en producción de a uno)
SYNC_ACTIVO=true
MARCAR_ACTIVO=true

PORT=8000
